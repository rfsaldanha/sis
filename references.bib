@article{Xavier2019,
  title = {As {{Regi{\~o}es}} de {{Sa{\'u}de}} No {{Brasil}} Segundo Interna{\c c}{\~o}es: M{\'e}todo Para Apoio Na Regionaliza{\c c}{\~a}o de Sa{\'u}de},
  author = {Xavier, Diego Ricardo and de Oliveira, Ricardo Antunes Dantas and Barcellos, Christovam and Saldanha, Raphael Freitas and Ramalho, Walter Massa and Laguardia, Josu{\'e} and Viacava, Francisco},
  year = {2019},
  journal = {Cadernos de Sa{\'u}de P{\'u}blica},
  volume = {35},
  number = {suppl 2},
  pages = {1--15},
  issn = {1678-4464},
  url = {https://doi.org/10.1590/0102-311x00076118},
  urlaccessdate = {5 jul. 2024},
  abstract = {{$<$}p{$>$}Este estudo aborda as regionaliza{\c c}{\~o}es da sa{\'u}de em v{\'a}rias escalas espaciais com base no fluxo de pacientes. Para isso, foram analisados dados por meio do relacionamento das informa{\c c}{\~o}es de origem e destino das intera{\c c}{\~o}es realizadas em n{\'i}vel municipal no Brasil em 2016. A an{\'a}lise tem como base a teoria dos grafos e utiliza um algoritmo de modularidade que busca agrupar munic{\'i}pios em comunidades que det{\^e}m grande n{\'u}mero de conex{\~o}es entre si. O algoritmo otimiza o n{\'u}mero de entradas e sa{\'i}das, levando em considera{\c c}{\~a}o o fluxo de pacientes. Os resultados s{\~a}o apresentados considerando diferentes estruturas espaciais pol{\'i}tico-administrativas. Levando-se em conta o fluxo de pacientes sem restri{\c c}{\~o}es espaciais foram constitu{\'i}das 29 comunidades no pa{\'i}s, 64 comunidades quando respeitados os limites das grandes regi{\~o}es e 164 considerando os deslocamentos apenas dentro dos estados. Os resultados demonstram a import{\^a}ncia de regi{\~o}es historicamente constitu{\'i}das, desconsiderando limites administrativos, para a efetiva{\c c}{\~a}o do acesso a servi{\c c}os de sa{\'u}de. Tamb{\'e}m revelam a ader{\^e}ncia aos limites administrativos em muitas Unidades da Federa{\c c}{\~a}o, demonstrando a import{\^a}ncia dessa escala espacial no contexto do acesso {\`a}s interna{\c c}{\~o}es. A metodologia usada traz contribui{\c c}{\~o}es relevantes para o planejamento regional em sa{\'u}de.{$<$}/p{$>$}},
  keywords = {Cidades,Cities,Geographic Information Systems,Regional Health Planning,Regionalizacao,Sistemas de Informacao Geografica},
  file = {/Users/raphaelsaldanha/Zotero/storage/83RVL655/Xavier et al. - 2019 - As Regiões de Saúde no Brasil segundo internações método para apoio na regionalização de saúde.pdf}
}

@inproceedings{pedrosoDataSciencePlatform2023,
  title = {Data {{Science Platform Applied}} to {{Health}} in {{Contribution}} to the {{Brazilian Unified Health System}}},
  booktitle = {Joint {{Workshops}} at 49th {{International Conference}} on {{Very Large Data Bases}} ({{VLDBW}}'23). {{Workshop}} on {{Data Ecosystems}} ({{DEco}}'23)},
  author = {Pedroso, Marcel and Salles, Rebecca and Saldanha, Raphael Freitas and {de Almeida}, Vinicius Kreischer and Souto, Gabriel and Paix{\~a}o, Balthazar and Ribeiro, Victor and Gritz, Raquel and Bonif{\'a}cio, Carmen and Miloski, Matheus and {de Sousa}, Carlos Augusto and Alencar, Gizelton Pereira and Alves, Ariane and Neto, Nelson Niero and Sabbadini, Let{\'i}cia and Ogasawara, Eduardo and Barcellos, Christovam and Porto, Fabio and Carraro, Lucas Zinato and Lima, Jefferson},
  year = {2023},
  address = {Vancouver, Canada},
  abstract = {The Data Science Platform Applied to Health (PCDaS) is a research and technological development project that aims to develop and apply novel data analysis methods to public health data. It fills a technological gap between the variety of data sources available in legacy and unstandardized formats and the current needs and possibilities of Data Science applications to consume and explore data for the benefit of the Brazilian Health System. PCDaS provides democratic access to health-related datasets and information by requiring fewer technological abilities from its users while maintaining a continuously updated stack of technologies. As a data ecosystem, our primary goal is to provide secure and remote access to health data, technological tools, and a robust infrastructure provided by our platform to process and analyze a large amount of data that generally demand computational power often unavailable to researchers. The infrastructure consists of multi-region on-premise and cloud servers prepared to deal with the heavy analysis of Big Data from anywhere from multiple users simultaneously. Providing secure and remote access to health databases, whether in their original form or processed, is a daily breakthrough for a public health researcher. Knowing that there is a place where they can access integrated data in a standard format makes the research process much more manageable. To ensure quality, our data engineering and governance teams process these data sources following a gold standard based on cross-tables provided by the Health Ministry (the TabNET system) and decoding the original variables into meaningful names provided by the sources. It is very relevant to emphasize the comprehensive documentation of metadata, attributes, and the ETL (Extract, Transform, Load) process for databases. Every part of these steps is described in detail on the PCDaS website, ensuring the comprehension and reproducibility of the process. These features ensure that PCDaS users can effectively leverage the platform's resources and capabilities, enabling them to conduct research, perform data analysis, and collaborate within a secure and supportive environment to contribute to the Brazilian Health System.},
  langid = {english},
  file = {/Users/raphaelsaldanha/Zotero/storage/85SEQG7F/Pedroso et al. - Data Science Platform Applied to Health in Contrib.pdf}
}

