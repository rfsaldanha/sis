@article{henningGOFAIROs2019,
  title = {{GO FAIR e os princ{\'i}pios FAIR: o que representam para a expans{\~a}o dos dados de pesquisa no {\^a}mbito da Ci{\^e}ncia Aberta}},
  shorttitle = {{GO FAIR e os princ{\'i}pios FAIR}},
  author = {Henning, Patricia Corr{\^e}a and Ribeiro, Claudio Jos{\'e} Silva and Da Silva Santos, Luiz Olavo Bonino and Dos Santos, Paula Xavier},
  year = {2019},
  month = apr,
  journal = {Em Quest{\~a}o},
  pages = {389--412},
  issn = {1808-5245, 1807-8893},
  url = {https://doi.org/10.19132/1808-5245252.389-412},
  urlaccessdate = {5 jul. 2024},
  abstract = {Este artigo tem o objetivo de apresentar os princ{\'i}pios FAIR e a iniciativa Global Open FAIR que busca disseminar esses princ{\'i}pios em todos os pa{\'i}ses interessados na aplica{\c c}{\~a}o dos dados FAIR (Findable, Accessible, Interoperable, Reusable) em seus servi{\c c}os de informa{\c c}{\~a}o. Prop{\~o}e ainda a divulga{\c c}{\~a}o e capacita{\c c}{\~a}o de institui{\c c}{\~o}es de ensino e pesquisa nesses princ{\'i}pios, com o intuito de promover a normaliza{\c c}{\~a}o no tratamento da gest{\~a}o dos dados garantindo a interoperabilidade entre eles. Como procedimento metodol{\'o}gico, utiliza a revis{\~a}o bibliogr{\'a}fica e documental para o embasamento te{\'o}rico sobre ci{\^e}ncia aberta, acesso aberto {\`a} informa{\c c}{\~a}o cient{\'i}fica e aos dados de pesquisa, visando fundamentar os princ{\'i}pios FAIR em aplica{\c c}{\~o}es e servi{\c c}os de gest{\~a}o de dados de pesquisa. Ressalta a import{\^a}ncia desse tipo de iniciativa para a expans{\~a}o mundial de abertura dos dados de pesquisa no {\^a}mbito da ci{\^e}ncia aberta. Ao final, aponta para a necessidade de uma mudan{\c c}a nos processos de pesquisa em ci{\^e}ncia e tecnologia na dire{\c c}{\~a}o da ado{\c c}{\~a}o desses princ{\'i}pios.},
  copyright = {https://creativecommons.org/licenses/by/4.0},
  langid = {portuguese},
  file = {/Users/raphaelsaldanha/Zotero/storage/V92F9P7B/Henning et al. - 2019 - GO FAIR e os princípios FAIR o que representam pa.pdf}
}

@article{Oliveira2011a,
  title = {Acesso {\`a} Assist{\^e}ncia Oncol{\'o}gica: Mapeamento Dos Fluxos Origem-Destino Das Interna{\c c}{\~o}es e Dos Atendimentos Ambulatoriais. {{O}} Caso Do C{\^a}ncer de Mama},
  author = {Oliveira, Evangelina Xavier Gouveia De and Melo, Enirtes Caetano Prates and Pinheiro, Rejane Sobrino and Noronha, Cl{\'a}udio Pompeiano and Carvalho, Marilia S{\'a}},
  year = {2011},
  journal = {Cadernos de Sa{\'u}de P{\'u}blica},
  volume = {27},
  number = {2},
  pages = {317--326},
  issn = {0102-311X},
  url = {https://doi.org/10.1590/S0102-311X2011000200013},
  urlaccessdate = {5 jul. 2024},
  abstract = {Este estudo analisa o fluxo de pacientes atendidas com c{\^a}ncer de mama, no Brasil, no {\^a}mbito do SUS, segundo o tipo de tratamento recebido. Foram identificadas redes de aten{\c c}{\~a}o oncol{\'o}gica com base nas informa{\c c}{\~o}es do Sistema de Informa{\c c}{\~o}es Hospitalares e do Sistema Informa{\c c}{\~o}es Ambulatoriais de Alta Complexidade em Oncologia, relativas ao per{\'i}odo 2005-2006, utilizando os programas TabWin e TerraView. O atendimento est{\'a} amplamente distribu{\'i}do pelo territ{\'o}rio nacional, com forte concentra{\c c}{\~a}o nos maiores centros, e ind{\'i}cios de escassez de atendimento mesmo nas regi{\~o}es onde a oferta de servi{\c c}os {\'e} maior. Grande propor{\c c}{\~a}o das pacientes reside a mais de 150km do local de atendimento. A identifica{\c c}{\~a}o das redes constitui ferramenta com aplica{\c c}{\~a}o importante no planejamento e na melhoria da distribui{\c c}{\~a}o dos servi{\c c}os, considerando que o acesso geogr{\'a}fico {\'e} relevante para o desfecho do tratamento. A redu{\c c}{\~a}o das taxas de morbidade e mortalidade depende da identifica{\c c}{\~a}o precoce, pois, uma vez identificado o caso, o tratamento adequado e {\'a}gil concorre para reduzir os impactos da doen{\c c}a.},
  isbn = {0102-311X  UL  - http://www.scielo.br/scielo.php?script=sci\_arttext\&pid=S0102-311X2011000200013\&nrm=iso},
  file = {/Users/raphaelsaldanha/Zotero/storage/QFDC6YEA/2011-Acesso__assistncia_oncolgica_mapeamento_dos_fluxos_origem-destino_das_internaes_e_dos_atendimentos_ambulatoriais._O.pdf}
}

