@article{Saldanha2019a,
  title = {Microdatasus: Pacote Para Download e Pr{\'e}-Processamento de Microdados Do {{Departamento}} de {{Inform{\'a}tica}} Do {{SUS}} ({{DATASUS}})},
  author = {Saldanha, Raphael Freitas and Bastos, Ronaldo Rocha and Barcellos, Christovam},
  year = {2019},
  journal = {Cadernos de Sa{\'u}de P{\'u}blica},
  volume = {35},
  number = {9},
  pages = {1--9},
  issn = {1678-4464},
  url = {https://doi.org/10.1590/0102-311x00032419},
  urlaccessdate = {5 jul. 2024},
  abstract = {O objetivo do estudo foi desenvolver um algoritmo capaz de realizar o download e o pr{\'e}-processamento de microdados fornecidos pelo Departamento de Inform{\'a}tica do SUS (DATASUS) para diversos sistemas de informa{\c c}{\~o}es em sa{\'u}de para a linguagem de programa{\c c}{\~a}o estat{\'i}stica R. O pacote desenvolvido permite o download e o pr{\'e}-processamento de dados de diversos sistemas de informa{\c c}{\~a}o em sa{\'u}de, com a inclus{\~a}o da rotulagem dos campos categ{\'o}ricos nos arquivos. A fun{\c c}{\~a}o de download foi capaz de acessar diretamente e reduzir o volume de trabalho para a sele{\c c}{\~a}o de arquivos e vari{\'a}veis de microdados junto ao DATASUS. J{\'a} a fun{\c c}{\~a}o de pr{\'e}-processamento foi capaz de efetuar a codifica{\c c}{\~a}o autom{\'a}tica de diversos campos categ{\'o}ricos. Dessa forma, a utiliza{\c c}{\~a}o desse pacote possibilita um fluxo de trabalho cont{\'i}nuo no mesmo programa, no qual esse algoritmo permite o download e o pr{\'e}-processamento, e outros pacotes do R permitem a an{\'a}lise de dados dos sistemas de informa{\c c}{\~a}o em sa{\'u}de do Sistema {\'U}nico de Sa{\'u}de (SUS).},
  keywords = {Electronic Data Processing,Health Information Systems,Processamento Eletronico de Dados,Sistemas de Informacao em Saude,Software},
  file = {/Users/raphaelsaldanha/Zotero/storage/AD7E6Y77/Saldanha, Bastos, Barcellos - 2019 - Microdatasus pacote para download e pré-processamento de microdados do Departamento de Informátic.pdf}
}

